# Built by scripts/ja/build-japanese-packs.py from the Mozc dictionary
data/ja/japanese-core/
# Built by scripts/ja/build-japanese-packs.py from the words of Wikipedia
# article titles (scripts/ja/build-japanese-wikipedia-words.py)
data/ja/japanese-wikipedia/
# Built by scripts/ja/build-japanese-english-pack.py from JMdict, Japanese
# Wikipedia and the Leipzig corpora
data/ja/japanese-english/
# Built by scripts/ja/build-japanese-lm.py from the Leipzig corpora
data/ja/japanese-lm/
# Built by scripts/ja/build-japanese-reranker-pack.py from a model trained
# with scripts/ja/train-japanese-wordlm.py on the zenz-v2.5 dataset
data/ja/japanese-reranker/
# Built by scripts/ja/build-japanese-slips-pack.py from the zenz-v2.5 readings
data/ja/japanese-slips/
# Built by scripts/ja/build-japanese-meaning-packs.py from the slang list,
# Wiktionary and WordNet
data/ja/japanese-slang/
data/ja/japanese-wiktionary/
data/ja/japanese-wordnet/
data/ja/english-meanings-ja/
data/ja/japanese-meanings-en/
