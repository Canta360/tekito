{"text": "この料理は思ったより簡単に作れるので、ぜひ試してみてください。", "chunks": ["この", "りょうりは", "おもったより", "かんたんに", "つくれるので、", "ぜひ", "ためして", "みてください。"], "also": []}
{"text": "去年の夏に行った旅行の写真を整理しています。", "chunks": ["きょねんの", "なつに", "いった", "りょこうの", "しゃしんを", "せいりしています。"], "also": []}
{"text": "子供の頃に読んだ本をもう一度読み返しています。", "chunks": ["こどもの", "ころに", "よんだ", "ほんを", "もういちど", "よみかえしています。"], "also": ["子どもの頃に読んだ本をもう一度読み返しています。"]}
{"text": "体調が悪いので、今日は早めに休ませてください。", "chunks": ["たいちょうが", "わるいので、", "きょうは", "はやめに", "やすませてください。"], "also": []}
{"text": "来月の引っ越しに向けて、少しずつ荷物をまとめています。", "chunks": ["らいげつの", "ひっこしに", "むけて、", "すこしずつ", "にもつを", "まとめています。"], "also": []}
{"text": "先週の土曜日に友達と映画を見に行きました。", "chunks": ["せんしゅうの", "どようびに", "ともだちと", "えいがを", "みに", "いきました。"], "also": []}
{"text": "この道をまっすぐ行くと、右側に郵便局があります。", "chunks": ["この", "みちを", "まっすぐ", "いくと、", "みぎがわに", "ゆうびんきょくが", "あります。"], "also": []}
{"text": "お忙しいところ申し訳ありませんが、確認をお願いできますか。", "chunks": ["おいそがしい", "ところ", "もうしわけ", "ありませんが、", "かくにんを", "おねがい", "できますか。"], "also": []}
{"text": "毎日少しずつでも続けることが大切だと思います。", "chunks": ["まいにち", "すこしずつでも", "つづけることが", "たいせつだと", "おもいます。"], "also": []}
{"text": "昨日は風が強くて、自転車に乗るのが大変でした。", "chunks": ["きのうは", "かぜが", "つよくて、", "じてんしゃに", "のるのが", "たいへんでした。"], "also": []}
{"text": "冷蔵庫の中に残っていた野菜でスープを作りました。", "chunks": ["れいぞうこの", "なかに", "のこっていた", "やさいで", "すーぷを", "つくりました。"], "also": []}
{"text": "図書館で借りた本の返却日が明日までです。", "chunks": ["としょかんで", "かりた", "ほんの", "へんきゃくびが", "あしたまでです。"], "also": []}
{"text": "新しい仕事にはだいぶ慣れてきましたが、まだ覚えることが多いです。", "chunks": ["あたらしい", "しごとには", "だいぶ", "なれてきましたが、", "まだ", "おぼえることが", "おおいです。"], "also": []}
{"text": "週末は天気が良ければ、山に登りに行く予定です。", "chunks": ["しゅうまつは", "てんきが", "よければ、", "やまに", "のぼりに", "いく", "よていです。"], "also": ["週末は天気がよければ、山に登りに行く予定です。"]}
{"text": "電車の中で寝てしまって、降りる駅を通り過ぎました。", "chunks": ["でんしゃの", "なかで", "ねてしまって、", "おりる", "えきを", "とおりすぎました。"], "also": []}
{"text": "久しぶりに実家に帰ったら、両親がとても喜んでくれました。", "chunks": ["ひさしぶりに", "じっかに", "かえったら、", "りょうしんが", "とても", "よろこんで", "くれました。"], "also": []}
{"text": "その件については、後ほど担当者から改めてご連絡します。", "chunks": ["その", "けんに", "ついては、", "のちほど", "たんとうしゃから", "あらためて", "ごれんらく", "します。"], "also": []}
{"text": "I will send you the report by Friday.", "chunks": ["@i", "@will", "@send", "@you", "@the", "@report", "@by", "@friday."], "also": []}
{"text": "Can we move the meeting to next week?", "chunks": ["@can", "@we", "@move", "@the", "@meeting", "@to", "@next", "@week?"], "also": []}
